# Server
PORT=3001
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001

# Supabase (names match the dashboard: Publishable / Secret)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# Legacy aliases still work:
# SUPABASE_ANON_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...

# OpenAI
OPENAI_API_KEY=sk-...

# Stripe (test mode) — Price IDs (price_…), not Product IDs
# If STRIPE_SECRET_KEY is set, STRIPE_WEBHOOK_SECRET is required
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Optional Redis — for local Node without Docker Compose Redis
# (Compose sets REDIS_URL=redis://redis:6379 automatically)
# REDIS_URL=redis://127.0.0.1:6379

# Load / backpressure knobs
INGEST_CONCURRENCY=2
INGEST_MAX_QUEUED=20
OPENAI_MAX_INFLIGHT=8
# Set false when running a dedicated `npm run worker -w knowbase-backend`
INGEST_EMBEDDED_WORKER=true
