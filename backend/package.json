    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ioredis": "^6.0.0",
    "mammoth": "^1.12.2",
    "nanoid": "^5.1.5",
    "openai": "^4.89.0",
    "pdf-parse": "^1.1.1",
    "stripe": "^17.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
