# syntax=docker/dockerfile:1

# API image: TypeScript backend + prebuilt widget.js (no Vite/Rolldown in this image).
# Rebuild widget on the host when it changes: `npm run build:widget`

FROM node:22-bookworm-slim AS build
WORKDIR /app

COPY package.json package-lock.json ./
COPY backend/package.json ./backend/
COPY frontend/package.json ./frontend/

# Backend compile only needs backend deps + root workspace install
RUN npm ci

COPY backend ./backend

RUN npm run build -w knowbase-backend

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3001

RUN apt-get update \
  && apt-get install -y --no-install-recommends curl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
COPY backend/package.json ./backend/
COPY frontend/package.json ./frontend/

RUN npm ci --omit=dev

COPY --from=build /app/backend/dist ./backend/dist
COPY --from=build /app/backend/public ./backend/public

WORKDIR /app/backend
EXPOSE 3001

HEALTHCHECK --interval=20s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS http://127.0.0.1:3001/health || exit 1

CMD ["node", "dist/index.js"]
